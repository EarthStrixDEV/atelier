# Google OAuth Client ID สำหรับปุ่ม "Save to Drive" (ไม่บังคับ — ไม่ตั้งค่านี้ ปุ่ม/UI ที่เกี่ยวกับ Drive จะซ่อนไปเลย)
# สร้างได้ที่ Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# ต้องเพิ่ม origin ของ dev/prod ใน "Authorized JavaScript origins" ด้วย
VITE_GOOGLE_CLIENT_ID=

# Supabase Cloud Sync (ไม่บังคับ — ไม่ตั้งค่า ส่วน Cloud Sync จะซ่อนไปเลย)
# ใช้ Project URL + publishable (anon) key จาก Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
